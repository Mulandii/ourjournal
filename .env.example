# Copy to .env and fill in.

# The address your journal will live at. Point its DNS A record at your server first.
# A free one works too, e.g. yourname.duckdns.org
JOURNAL_HOST=journal.example.com

# A secret you type once on the setup screen to create your two accounts.
# Make one with:  openssl rand -hex 12
# You can delete it after setup (setup only works while no accounts exist).
JOURNAL_SETUP_CODE=

# Your timezone (used for the nightly backup time), e.g. Europe/London, America/New_York
TZ=UTC

# Only if your server already runs Traefik:
# COMPOSE_FILE=docker-compose.traefik.yml
